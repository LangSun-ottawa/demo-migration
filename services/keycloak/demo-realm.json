{
  "realm": "migration-demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "groups": [{"name": "demo-readonly"}, {"name": "demo-readwrite"}],
  "clients": [{
    "clientId": "http://127.0.0.1:8001/api/demo/auth/saml/metadata/",
    "name": "Migration Django SAML SP",
    "enabled": true,
    "protocol": "saml",
    "redirectUris": ["http://127.0.0.1:8001/api/demo/auth/saml/acs/"],
    "attributes": {
      "saml.assertion.signature": "true",
      "saml.authnstatement": "true",
      "saml.server.signature": "true",
      "saml.client.signature": "false",
      "saml.signature.algorithm": "RSA_SHA256",
      "saml_name_id_format": "persistent",
      "saml_force_name_id_format": "true",
      "saml.force.post.binding": "true"
    },
    "protocolMappers": [{
      "name": "groups",
      "protocol": "saml",
      "protocolMapper": "saml-group-membership-mapper",
      "config": {"attribute.name": "groups", "attribute.nameformat": "Basic", "full.path": "false", "single": "false"}
    }]
  }],
  "users": [
    {"username": "sso-reader", "enabled": true, "firstName": "Demo", "lastName": "Reader", "email": "reader@example.invalid", "groups": ["demo-readonly"], "credentials": [{"type": "password", "value": "LocalReader123!", "temporary": false}]},
    {"username": "sso-writer", "enabled": true, "firstName": "Demo", "lastName": "Writer", "email": "writer@example.invalid", "groups": ["demo-readwrite"], "credentials": [{"type": "password", "value": "LocalWriter123!", "temporary": false}]}
  ]
}
