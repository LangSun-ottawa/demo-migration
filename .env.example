# Copy this file to .env. Never commit the populated .env file.
ASSISTANT_PROVIDER=deterministic
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=

# FastAPI uses this URL to fetch authenticated context from Django.
DJANGO_BASE_URL=http://127.0.0.1:8001
DJANGO_SESSION_COOKIE_NAME=sessionid
DJANGO_CSRF_COOKIE_NAME=csrftoken
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# Gateway -> independent Pi Agent Service. The browser never supplies these.
PI_AGENT_BASE_URL=http://127.0.0.1:8010
PI_AGENT_SERVICE_TOKEN=
PI_PROVIDER=openai-codex
# Leave empty to follow the model selected in local Pi settings.
PI_MODEL=

# Address Pi receives for its narrow, run-scoped tool calls.
TOOL_BROKER_BASE_URL=http://host.docker.internal:8002
AGENT_RUN_TTL_SECONDS=120
AGENT_RUN_TIMEOUT_SECONDS=60
